// VIDEO 10 - BOOLEANS & COMPARISONS

// A boolean can only have two values:
// true or false.
//
// Booleans are useful when checking
// if something is true or false.
//
// Comparison operators are used to compare
// two values.
//
// == means equal to
// != means not equal to
// > means greater than
// < means less than
// >= means greater than or equal to
// <= means less than or equal to


// BOOLEAN

$isStudent = true;

var_dump($isStudent);


// COMPARISON

$age = 19;

var_dump($age == 19);
var_dump($age > 18);
var_dump($age < 18);


// TRUE OR FALSE

// If the comparison is correct,
// PHP will return true.
//
// If the comparison is wrong,
// PHP will return false.

?>